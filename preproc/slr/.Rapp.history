getNextColor <- function(n.prev.rows) {#
    if (n.prev.rows < 2) {#
        colors <- brewer.pal(3, "Set3")#
        colors[n.prev.rows + 1]#
    } else {#
        colors <- brewer.pal(min(n.prev.rows + 1, 12), "Set3")#
        tail(colors, 1)#
    }#
}#
#
makeInvestRow <- function(channel, adaptation, investment, color) {#
    tibble(Channel=channel, Adaptation=adaptation, Investment=paste0("£", signif(10^investment, 2), "M / yr"),#
           Legend=paste0('<span class="legend-circle" style="background-color: ', color, ';">'))#
}#
#
constructTableHTML <- function(rows) {#
    if (!is.null(rows)) {#
        investRows <- apply(rows, 1, function(row) {#
            paste0("<tr>",#
                   paste(sapply(row, function(cell) {#
                       paste0("<td>", cell, "</td>")#
                   }), collapse=""),#
                   "</tr>")#
        })#
        tableHeader <- paste0("<tr>",#
                              paste(sapply(colnames(rows), function(col) {#
                                  paste0("<th>", col, "</th>")#
                              }), collapse=""),#
                              "</tr>")#
        tableHTML <- paste0("<table class='invest-table'>",#
                            tableHeader,#
                            paste(investRows, collapse=""),#
                            "</table>")#
#
        HTML(tableHTML)#
    }#
}#
#
load.risk.channel <- function(channel, load.map, scenario, measure, quant) {#
    print("load.risk.channel")#
    df <<- read.csv(paste0("../Dataset v2/", datasets[[channel]]))#
    if (channel == 'Local temperatures') {#
        df$mu <<- df$mu - 273.13#
        df$ci05 <<- df$ci05 - 273.13#
        df$ci95 <<- df$ci95 - 273.13#
    } else if (channel == 'Coastal impacts') {#
        ## 2015 conversation from https://www.poundsterlinglive.com/history/GBP-USD-2015#
        df$mu <<- df$mu * 1000 * 1.5283#
        df$ci05 <<- df$ci05 * 1000 * 1.5283#
        df$ci95 <<- df$ci95 * 1000 * 1.5283#
    } else if (channel == "Total costs") {#
        df$mu <<- df$mu * 100#
        df$ci05 <<- df$ci05 * 100#
        df$ci95 <<- df$ci95 * 100#
    }#
    timeseries.id(NULL)#
    fix.limits(df)#
}#
#
load.channel.shapefile <- function(channel) {#
    print("load.channel.shapefile")#
#
    spdf <- st_read(regions[[channel]])#
    if (!is.na(dataset2region[[channel]][1])) {#
        if (dataset2region[[channel]][1] == 'ISOADM1')#
            spdf$ISOADM1 <- gsub("-", "", spdf$adm1_code)#
        if (dataset2region[[channel]][1] == 'locationax') {#
            rowparts <- strsplit(spdf$locationna, ' ')#
            spdf$locationax <- sapply(rowparts, function(parts) paste0(paste(parts[-1], collapse=''), parts[1]))#
        }#
    }#
    if (dataset2region[[channel]][3] == 'divaname')#
        spdf$divaname <- sapply(spdf$locationid, function(locid) ifelse(locid %in% divanames$locationid, divanames$name[divanames$locationid == locid], ""))#
    if (!('PID' %in% names(spdf)))#
        spdf$PID <- 1:nrow(spdf)#
#
    spdf#
}#
#
get.adaptgraph.with.prev <- function(adtchannel, adaptation, investment, risk.input, adt.input, savedInvestsPdf) {#
    label <- adtchannel#
    if (!(label %in% savedInvestsPdf$label)) {#
        return(get.adaptgraph(adtchannel, adaptation, investment, risk.input, adt.input))#
    }#
#
    adaptgraph.prev <- savedInvestsPdf[savedInvestsPdf$label == label, -1:-2]#
#
    pdf4 <- get.adaptgraph(adtchannel, adaptation, log10(10^investment - sum(adaptgraph.prev$benefits[adaptgraph.prev$measure == 'Invest' & adaptgraph.prev$scenario == 'Most Likely'])),#
                           risk.input, adt.input)#
#
    pdf5 <- rbind(cbind(call='curr', pdf4), cbind(call='prev', adaptgraph.prev))#
    pdf5 %>% group_by(year, scenario, measure) %>% dplyr::summarize(benefits=benefits[call == 'curr'] - sum(benefits[call == 'prev']))#
}#
#
get.adaptgraph <- function(adtchannel, adaptation, investment, risk.input, adt.input) {#
    ## Calculate (mu - baseline) * (1 - mu.adt)#
    if (adtchannel == "Coastal impacts") {#
        pdf <- slr.adapt.prop(10^investment, adt.input)#
        pdf2 <- pdf %>% left_join(risk.input, by=c('year', 'segment'), suffix=c('.adt', '')) %>% mutate(benefits=mu * (1 - mu.adt)) %>%#
            group_by(year, scenario, measure) %>% dplyr::summarize(benefits=sum(benefits))#
    } else if (adtchannel == "All-source flooding") {#
        pdf <- flood.adapt.prop(10^investment, adt.input)#
        pdf2 <- risk.input %>% mutate(benefits=mu * (1 - pdf$mu)) %>%#
            group_by(year, scenario, measure) %>% dplyr::summarize(benefits=sum(benefits))#
    } else if (adtchannel == "Agricultural productivity") {#
        pdf <- agric.adapt.prop(10^investment, adt.input)#
        pdf2 <- risk.input %>%#
            left_join(pdf, by=c('scenario', 'year', 'measure', 'county'), suffix=c('', '.adt')) %>%#
            mutate(benefits=mu * (1 - mu.adt)) %>%#
            group_by(year, scenario, measure) %>% dplyr::summarize(benefits=sum(benefits))#
    } else if (adtchannel == "Labour productivity & supply") {#
        pdf <- labor.adapt.prop(10^investment, adt.input)#
        pdf2 <- risk.input %>%#
            left_join(pdf, by=c('scenario', 'year', 'measure')) %>%#
            mutate(benefits=ifelse(group == 'Effort', mu * (1 - mu.effort),#
                                   mu * (1 - mu.hours))) %>%#
            group_by(year, scenario, measure) %>% dplyr::summarize(benefits=sum(benefits))#
    } else if (adtchannel == "Heat-related mortality") {#
        adapt.func <- list("Proportional to Benefits"=health.adapt.prop, "Air Conditioning"=health.adapt.aircon, "Shutters"=health.adapt.shutters)[[adaptation]]#
        pdf <- adapt.func(10^investment, adt.input)#
        pdf2 <- risk.input %>%#
            left_join(pdf, by=c('scenario', 'year', 'measure'), suffix=c('', '.adt')) %>%#
            mutate(benefits=mu * (1 - mu.adt)) %>%#
            group_by(year, scenario, measure) %>% dplyr::summarize(benefits=sum(benefits))#
    }#
#
    pdf3 <- pdf2 %>% left_join(subset(pdf2, year == 2025), by='scenario', suffix=c('', '.2025')) %>%#
        mutate(benefits=ifelse(benefits.2025 < 0, benefits - benefits.2025, benefits))#
#
    rbind(data.frame(year=2025, scenario=c("High Risk", "Most Likely"),#
                     measure="Invest", benefits=-10^investment),#
          pdf3[, c('year', 'scenario', 'measure', 'benefits')])#
}#
#
server <- function(input, output, session) {#
    previous <- 'TEST'#
    shapefile_data <- reactiveVal(NULL)#
#
    session$onSessionEnded(function() {#
        stopApp()#
    })#
#
    ## reactive filtering data from UI#
    reactive_data <- reactive({#
        print("reactive")#
        scenario <- ifelse(input$scenario == 'Most Likely - Expected annual damage', 'Most Likely', 'High Risk')#
        measure <- ifelse(input$scenario == 'High Risk - Extreme year', 'Extreme', 'EAD')#
        quant <- ifelse(input$quant == "1-in-20 less than", 'ci05', ifelse(input$quant == "1-in-20 more than", 'ci95', 'mu'))#
#
        if (substring(previous, 1, nchar(input$channel)) != input$channel) {#
            print(input$channel)#
            load.map.arg <- F#
            if (previous != 'TEST')#
                if (regions[[strsplit(previous, '_')[[1]][1]]] != regions[[input$channel]])#
                    load.map.arg <- T#
            load.risk.channel(input$channel, load.map.arg, scenario, measure, quant)#
        }#
#
        list(channel=input$channel, quant=quant, scenario=scenario, measure=measure, year=input$year[1])#
    })#
#
    ## static backround map#
    output$map1 <- renderLeaflet({#
        print("renderLeaflet")#
        leaflet() %>%#
            addTiles() %>%#
            setView(lat=54, lng=-3, zoom=6)#
    })#
#
    output$timeseries <- renderPlot({#
        req(timeseries.id)#
        lst <- reactive_data()#
        spdf <- shapefile_data()#
        if (is.null(timeseries.id())) {#
            if (dataset2legend[[lst$channel]] == "(hours/person)") {#
                polydata <- read.csv("shapefiles/ne_10m_admin_1_states_provinces.shp.csv")#
                polydata$ISOADM1 <- paste0(polydata$adm0_a3, polydata$diss_me)#
#
                subdf <- df %>% filter(scenario == lst$scenario & measure == lst$measure) %>%#
                    left_join(polydata[, c('ISOADM1', 'popsum')], by='ISOADM1') %>% group_by(year) %>%#
                    dplyr::summarize(mu=wtd.mean(mu, popsum),#
                                     ci05=wtd.mean(ci05, popsum),#
                                     ci95=wtd.mean(ci95, popsum))#
            } else if (dataset2legend[[lst$channel]] == "(mm since 1985-2005)") {#
                subdf <- df %>% filter(scenario == lst$scenario & measure == lst$measure) %>% group_by(year) %>%#
                    dplyr::summarize(mu=mean(mu), ci05=mean(ci05), ci95=mean(ci95))#
            } else {#
                subdf <- df %>% filter(scenario == lst$scenario & measure == lst$measure) %>% group_by(year) %>%#
                    dplyr::summarize(mu=sum(mu), ci05=sum(ci05), ci95=sum(ci95))#
            }#
        } else {#
            subdf <- df %>% filter(scenario == lst$scenario & measure == lst$measure & county == spdf$NAME_3[spdf$PID == timeseries.id()])#
        }#
#
        ggplot(subdf, aes(year, mu)) +#
            geom_line() + geom_ribbon(aes(ymin=ci05, ymax=ci95), alpha=.5) +#
            theme_bw(base_size=16) +#
            xlab(NULL) + ylab(paste(lst$channel, "\n", dataset2legend[[lst$channel]]))#
    }, height=250)#
#
    observeEvent(input$scenario, {#
        if (input$scenario == 'High Risk - Extreme year') {#
            updateSliderTextInput(session, "year",#
                                  choices=c(2030, 2040, 2050), selected=c(2030, 2040, 2050)[which.min(abs(c(2030, 2040, 2050) - input$year))])#
        } else {#
            updateSliderTextInput(session, "year",#
                                  choices=2025:2075, selected=input$year)#
        }#
    })#
#
    observeEvent(input$map1_shape_click, {#
        ## Store the click event details#
        click <- input$map1_shape_click#
#
        timeseries.id(click$id)#
    })#
#
    observe({#
        print("observe")#
        prev.save <- previous#
        lst <- reactive_data()#
#
        replace.legend <- substring(previous, 1, nchar(lst$channel)) != lst$channel#
        previous <<- paste(lst$channel, lst$measure, lst$quant, lst$scenario, lst$year, sep='_')#
        output$channelh3 <- renderText(lst$channel)#
#
        spdf <- load.channel.shapefile(lst$channel)#
        shapefile_data(spdf)#
        lt <- leafletProxy("map1", session)#
        if (replace.legend) {#
            fix.limits(df)#
            lt <- lt %>% clearControls() %>%#
                addLegend(pal=mypalette, values=rev(seq(limits[1], limits[2], length.out=20)), opacity=0.5, title = paste(lst$channel, "<br/>", dataset2legend[[lst$channel]]), position = "topright")#
        }#
        lt <- lt %>% make.map(spdf, lst$channel, lst$scenario, lst$measure, lst$year, lst$quant, dataset2region[[lst$channel]][1], dataset2region[[lst$channel]][2], dataset2region[[lst$channel]][3], group=previous) %>%#
            clearGroup(prev.save)#
    })#
#
    ## Adaptation Tab#
    adt.data <- reactiveValues(adt.input=NULL, risk.input=NULL)#
#
    observeEvent(input$adtchannel, {#
        if (input$adtchannel == "Coastal impacts") {#
            adt.data$adt.input <- load.slr.adapt()#
            adt.data$risk.input <- to.gdpprop(read.csv("../Dataset v2/coastal.csv"),#
                                              synthesis.channels[[input$adtchannel]][3])#
        } else if (input$adtchannel == "All-source flooding") {#
            adt.data$adt.input <- load.flood.adapt()#
            adt.data$risk.input <- to.gdpprop(read.csv("../Dataset v2/flooding.csv"),#
                                              synthesis.channels[[input$adtchannel]][3])#
        } else if (input$adtchannel == "Agricultural productivity") {#
            adt.data$adt.input <- load.agric.adapt()#
            adt.data$risk.input <- to.gdpprop(read.csv("../Dataset v2/agriculture.csv"),#
                                              synthesis.channels[[input$adtchannel]][3])#
        } else if (input$adtchannel == "Labour productivity & supply") {#
            adt.data$adt.input <- load.labor.adapt()#
            adt.data$risk.input <- rbind(cbind(group="Effort",#
                                               to.gdpprop(read.csv("../Dataset v2/labourprod.csv"),#
                                                          synthesis.channels[["Labour productivity"]][3])),#
                                         cbind(group="Hours",#
                                               to.gdpprop(read.csv("../Dataset v2/labourhours.csv") %>% dplyr::select(!c(hours1.mu, hours1.ci05, hours1.ci95)) %>% rename(county=ISOADM1),#
                                                          synthesis.channels[["Labour supply"]][3])))#
        } else if (input$adtchannel == "Heat-related mortality") {#
            adt.data$adt.input <- load.health.adapt()#
            adt.data$risk.input <- to.gdpprop(read.csv("../Dataset v2/health.csv"),#
                                              synthesis.channels[[input$adtchannel]][3])#
        }#
#
        options <- adaptation.options[[input$adtchannel]]#
        updatePickerInput(session, "adaptation",#
                          choices = options)#
    })#
#
    output$adtgraph <- renderPlotly({#
        print("Benefit")#
        req(adt.data$adt.input)#
        req(adt.data$risk.input)#
#
        print("A") # DELAY AFTER THIS?#
        pdf3 <- get.adaptgraph.with.prev(input$adtchannel, input$adaptation, input$investment, adt.data$risk.input, adt.data$adt.input,#
                                             savedInvests$pdf)#
#
        print("B")#
        pdf4 <- rbind(cbind(UID="Current", channel=input$adtchannel, pdf3), savedInvests$pdf)#
        pdf5 <- pdf4 # %>% group_by(channel, scenario, measure, year) %>% mutate(label=ifelse(rep(n(), n()) == 1, label, paste(label, n():1)))#
#
        print("C") # DELAY AFTER THIS?#
        pdf5.s0 <- pdf5 %>% filter(scenario == "Most Likely" & measure == 'Invest')#
        pdf5.s1 <- pdf5 %>% filter(scenario == "Most Likely" & measure == 'EAD') %>%#
            group_by(year) %>% mutate(benefits=cumsum(benefits))#
        pdf5.s2 <- pdf5 %>% filter(scenario == "High Risk" & measure == 'EAD') %>%#
            group_by(year) %>% mutate(benefits=cumsum(benefits))#
        print("D") # DELAY AFTER THIS#
#
        uid.colors <- setNames(c(sapply(names(savedInvests$legend), function(nn) savedInvests$legend[[nn]]), "Current"),#
                               c(names(savedInvests$legend), getNextColor(length(savedInvests$legend))))#
#
        ## Subplot titles#
        title1 <- list(#
            text = "Most Likely Scenario",#
            xref = "paper",#
            yref = "paper",#
            yanchor = "bottom",#
            xanchor = "center",#
            align = "center",#
            x = 0.5,#
            y = 1,#
            showarrow = FALSE#
        )#
#
        title2 <- list(#
            text = "High Risk Scenario",#
            xref = "paper",#
            yref = "paper",#
            yanchor = "bottom",#
            xanchor = "center",#
            align = "center",#
            x = 0.5,#
            y = 1,#
            showarrow = FALSE#
        )#
#
        plotly::subplot(plot_ly() %>%#
                        add_lines(x=pdf5.s1$year, y=pdf5.s1$benefits, type='scatter', mode='lines',#
                                  name=pdf5.s1$UID) %>% #, line=list(color=uid.colors[pdf5.s1$UID])) %>%#
                        add_lines(x=c(2025, 2075), y=-sum(pdf5.s0$benefits) * 1e6 * gbp.usd.2025 / gdp.2025.usd, name="Investment", line=list(dash='dash', color='grey')) %>%#
                        add_bars(x=2025, y=-pdf5.s0$benefits * 1e6 * gbp.usd.2025 / gdp.2025.usd, name=pdf5.s0$UID) %>%#
                      # , marker=list(color=uid.colors[pdf5.s0$UID])) %>%#
                        layout(#
                            yaxis=list(#
                                tickformat="%",    # Format y-axis as percentages#
                                title="Costs and Benefits (% GDP)" # Optionally add a title to the y-axis#
                            ), barmode='stack', annotations=title1),#
                        plot_ly() %>%#
                        add_lines(x=pdf5.s2$year, y=pdf5.s2$benefits, type='scatter', mode='lines',#
                                  name=pdf5.s2$UID) %>% #, line=list(color=uid.colors[pdf5.s2$UID])) %>%#
                        add_lines(x=c(2025, 2075), y=-sum(pdf5.s0$benefits) * 1e6 * gbp.usd.2025 / gdp.2025.usd, name="Investment", line=list(dash='dash', color='grey')) %>%#
                        add_bars(x=2025, y=-pdf5.s0$benefits * 1e6 * gbp.usd.2025 / gdp.2025.usd, name=pdf5.s0$UID) %>% #, marker=list(color=uid.colors[pdf5.s0$UID])) %>%#
                        layout(#
                            yaxis=list(#
                                tickformat="%",    # Format y-axis as percentages#
                                title="Costs and Benefits (% GDP)" # Optionally add a title to the y-axis#
                            ), barmode='stack', annotations=title2),#
                        shareY=T, nrows=1, margin=0.01) %>% hide_legend()#
    })#
#
    ## Define a reactiveValues object to store saved investurations#
    savedInvests <- reactiveValues(rows=data.frame(), pdf=data.frame(), legend=list())#
#
    ## Table to display saved investurations#
    output$investTable <- renderUI({#
        constructTableHTML(rbind(cbind(makeInvestRow(input$adtchannel, input$adaptation, input$investment, getNextColor(length(savedInvests$legend))),#
                                       action=paste0('<button class="btn btn-success" onclick="$(\'#saveButton\').click(); return false;">Save</button>')),#
                                 savedInvests$rows[, -1]))#
    })#
#
    ## Save investuration on button click#
    observeEvent(input$saveButton, {#
        uid <- Sys.time()#
#
        print("OK") # DELAY AFTER THIS?#
        print(length(savedInvests$legend))#
        print(savedInvests$legend)#
        print("HUH")#
        savedInvests$legend[[uid]] <- getNextColor(length(savedInvests$legend))#
        print("OO")#
        newEntry <- makeInvestRow(input$adtchannel, input$adaptation, input$investment, savedInvests$legend[[uid]])#
#
        print("KO")#
        newRow <- cbind(UID=uid, newEntry,#
                        action=paste0('<button class="btn btn-success" onclick="Shiny.onInputChange(\'deleteButton\', this.parentElement.parentElement.rowIndex - 1);">Delete</button>'))#
#
        print("KK")#
        savedInvests$rows <- rbind(newRow, savedInvests$rows)#
#
        pdf3 <- get.adaptgraph.with.prev(input$adtchannel, input$adaptation, input$investment, adt.data$risk.input, adt.data$adt.input,#
                                         savedInvests$pdf)#
        savedInvests$pdf <- rbind(savedInvests$pdf, cbind(UID=uid, channel=input$adtchannel, pdf3))#
    })#
#
    ## Load investuration on button click#
    observeEvent(input$deleteButton, {#
        selectedRow <- as.numeric(input$deleteButton)#
        if (selectedRow <= nrow(savedInvests$rows)) {#
            uid <- savedInvests$rows$UID[selectedRow]#
            savedInvests$rows <- savedInvests$rows[-selectedRow,]#
            savedInvests$pdf <- subset(savedInvests$pdf, UID != uid)#
        }#
    })#
}#
#
df <- NULL#
limits <- NULL#
timeseries.id <- reactiveVal(NULL)#
load.risk.channel('Agricultural productivity', T, "High Risk", "EAD", "mu")#
#
## Create a color palette for the map:#
mypalette <- colorNumeric( palette="Spectral", domain=limits, na.color="transparent", reverse=T)#
#
shinyApp(ui, server)
library(ggplot2)#
library(dplyr)#
#
df <- data.frame(stddev=c(0, rep(0.01, 3), rep(0.05, 3), rep(0.1, 3)), rr=rnorm(10, 0, 1), KK=rnorm(10, 0, 1))#
#
ggplot(df %>% group_by(stddev) %>% summarize(mu=mean(rr), lo=min(rr), hi=max(rr))#
       aes(stddev, mu)) +#
    geom_line() +#
    geom_ribbon(aes(ymin=lo, ymax=hi), alpha=.5) +#
    theme_bw()
ggplot(df %>% group_by(stddev) %>% summarize(mu=mean(rr), lo=min(rr), hi=max(rr)),#
       aes(stddev, mu)) +#
    geom_line() +#
    geom_ribbon(aes(ymin=lo, ymax=hi), alpha=.5) +#
    theme_bw()
library(ggplot2)#
library(dplyr)#
#
df <- data.frame(stddev=c(0, rep(0.01, 3), rep(0.05, 3), rep(0.1, 3)),#
                 rr=c(0, -1, 0, 1, -2, 0, 2, -3, 0, 3))#
#
ggplot(df %>% group_by(stddev) %>% summarize(mu=mean(rr), lo=min(rr), hi=max(rr)),#
       aes(stddev, mu)) +#
    geom_line() +#
    geom_ribbon(aes(ymin=lo, ymax=hi), alpha=.5) +#
    theme_bw()
compare = 'climate-only'
if (compare == 'slcp-only') {#
    pdf2 <- scen.diff.fracgdp.mean("IntegratedAction", "LTCAction")#
} else if (compare == 'total') {#
    pdf2 <- scen.diff.fracgdp.mean("IntegratedAction", "Baseline")#
} else {#
    pdf2 <- scen.diff.fracgdp.mean("LTCAction", "Baseline")#
}
pdf3 <- pdf2 %>% filter(panel == 'Aggregate') %>%#
    mutate(label=ifelse(label %in% c("Costs", "Feedback"), label, "Damages")) %>%#
    group_by(name, channel, label, time) %>% summarize(diff=sum(diff)) %>%#
    group_by(name, channel, label) %>% arrange(time) %>%#
    reframe(year=seq(2025, 2100, by=5), diff=splinefun(c(2025, time), c(0, diff), method='monoH.FC')(year)) %>%#
    mutate(fulllabel=ifelse(label == 'Costs', label,#
                     ifelse(channel == 'climate', "Climate damages",#
                     ifelse(channel == 'pollution', "Pollution damages", "other"))))#
pdf3$fulllabel <- factor(pdf3$fulllabel, levels=c('Climate damages', 'Pollution damages', 'Costs'))

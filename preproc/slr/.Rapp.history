gsat2100 <- gsat[gsat$year == 2100,]#
#
gsat.likely <- data.frame() # Just scenario and run_id#
qrange <- .5#
while (nrow(gsat.likely) < sum(gsat2100$scenario == 'ssp370')) {#
    print(qrange)#
    bounds <- quantile(gsat2100$gsat, c(.5 - qrange/2, .5 + qrange/2))#
    newdraws <- gsat2100 %>% group_by(scenario, run_id) %>% filter(gsat >= bounds[1] & gsat <= bounds[2]) %>%#
        filter(!(run_id %in% gsat.likely$run_id))#
    if (nrow(newdraws) > 0) {#
        newdraws2 <- newdraws %>% group_by(run_id) %>% summarize(chosen=sample(scenario, 1),#
                                                                 year=2100, gsat=gsat[scenario == chosen],#
                                                                 model=model[scenario == chosen]) %>%#
            rename(scenario=chosen)#
        gsat.likely <- rbind(gsat.likely, newdraws2)#
    }#
    qrange <- qrange + (sum(gsat2100$scenario == 'ssp370') - nrow(gsat.likely) + 4) / nrow(gsat2100)#
}

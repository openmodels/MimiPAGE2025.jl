all_shortest_paths <- function(start, iters=Inf) {#
    dists = rep(Inf, max(airports$Airport.ID, na.rm=T))#
    dists[start] = 0#
    queue = c(start)#
#
    while (length(queue) > 0 && iters > 0) {#
        ## Dequeue first item#
        node = queue[1]#
        queue = queue[-1]#
        mydist = dists[node]#
#
        ## Consider each neighbor#
        for (ii in which(routes2$Source.airport.ID == node)) {#
            if (dists[routes2$Destination.airport.ID[ii]] > mydist + 1) {#
                dists[routes2$Destination.airport.ID[ii]] = mydist + 1#
                queue = c(queue, routes2$Destination.airport.ID[ii])#
            }#
        }#
#
        iters = iters - 1#
    }#
#
    dists#
}#
#
airports$meandist = NA#
for (ii in 1:nrow(airports)) {#
    print(ii)#
    dists = all_shortest_paths(airports$Airport.ID[ii])#
    airports$meandist[ii] = mean(dists[dists != 0 & dists != Inf])#
}#
#
head(airports[order(airports$meandist),])#
head(airports[order(airports$meandist, decreasing=T),])#
#
airports$meandist[airports$meandist <= 2] <- Inf#
head(airports[order(airports$meandist),])
ggplot(airports, aes(degree.byairl)) +#
    geom_histogram() + scale_x_log10() + scale_y_log10()
quantile(airports$degree.byairl)
quantile(airports$degree.bydest)

"),#
                  tags$script(HTML(#
                           "$(function() { $('#map1').css('max-width', '100%'); });"#
                       )),#
                  titlePanel(h1("UK Climate Change Risk Maps", style='text-align: center')),#
                  sidebarLayout(#
                      sidebarPanel(#
                          style="z-index:500; max-width: 600px", # legend over my map (map z = 400)#
                          pickerInput(#
                              inputId = "channel",#
                              label = "Channel:",#
                              choices = risk.options,#
                              selected = "Agricultural productivity",#
                              options = list(#
                                  `actions-box` = TRUE,#
                                  size = 10,#
                                  `selected-text-format` = "count > 3"#
                              ),#
                              multiple = F#
                          ),#
                          pickerInput(#
                              inputId = "scenario",#
                              label = "Scenario:",#
                              choices = c('Most Likely - Expected annual damage', 'High Risk - Expected annual damage',#
                                          'High Risk - Extreme year'),#
                              selected = 'High Risk - Expected annual damage',#
                              options = list(#
                                  `actions-box` = TRUE,#
                                  size = 10,#
                                  `selected-text-format` = "count > 3"#
                              ),#
                              multiple = F#
                          ),#
                          textOutput("channelh3", container=h3),#
                          plotOutput("timeseries", height=250)#
                      ),#
                      mainPanel(#
                          fluidRow(#
                              column(4,#
                                     sliderTextInput("year", "Year",#
                                                     choices=2025:2075,#
                                                     selected = 2050)),#
                              column(4,#
                                     sliderTextInput("quant", "Probability",#
                                                     choices=c('1-in-20 less than', 'Expected', '1-in-20 more than'),#
                                                     selected = 'Expected'))),#
                          fluidRow(#
                              column(8,#
                                     leafletOutput("map1", width="100%", height="500px"), class="col-sm-8")))))),#
    nav_panel(title="Adaptation Planning",#
              fluidPage(#
                  tags$head(tags$script(HTML(JS.logify))),#
                  tags$head(tags$script(HTML(JS.onload))),#
                  titlePanel(h1("Adaptation Decision Support", style='text-align: center')),#
                  sidebarLayout(#
                      sidebarPanel(#
                          pickerInput(#
                              inputId = "adtchannel",#
                              label = "Channel:",#
                              choices = names(adaptation.options),#
                              options = list(#
                                  `actions-box` = TRUE,#
                                  size = 10,#
                                  `selected-text-format` = "count > 3"#
                              ),#
                              multiple = F#
                          ),#
                          pickerInput(#
                              inputId = "adaptation",#
                              label = "Adaptation:",#
                              choices = NULL,#
                              options = list(#
                                  `actions-box` = TRUE,#
                                  size = 10,#
                                  `selected-text-format` = "count > 3"#
                              ),#
                              multiple = F#
                          ),#
                          sliderInput("investment", "Investment",#
                                      min=log10(1), max=log10(1e4),#
                                      value = log10(100), step=.1,#
                                      pre="£", post="M / yr", sep=",", ticks=F)),#
                      mainPanel(#
                          fluidRow(#
                              column(12, plotlyOutput("adtgraph"))),#
                          uiOutput("investTable"),#
                          hidden(actionButton("saveButton", "Save Investuration")),#
                          hidden(actionButton("loadButton", "Load Selected Investuration")))))),#
    nav_spacer(),#
    nav_menu(title="Links",#
             align="right",#
             nav_item(tags$a("ACCREU", "https://www.accreu.eu/")),#
             nav_item(tags$a("ATTENUATE", "https://www.lse.ac.uk/granthaminstitute/projects/attenuate-creating-the-enabling-conditions-for-uk-climate-adaptation-investment/")))#
)#

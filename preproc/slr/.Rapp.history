#
order_of_magnitude <- function(x) {#
    if (is.na(x)) return(NA)#
    if (x == 0) return(0)#
    floor(log10(abs(x)))#
}#
#
format_estimate_with_ci <- function(mu, ci05, ci95, bold='') {#
    if (is.na(mu))#
        return(NA)#
    ## Calculate the range#
    ci_range <- ifelse(mu > ci05, ifelse(mu < ci95, ci95 - ci05, mu - ci05), ci95 - mu)#
#
    ## Determine the suitable number of digits by examining significant figures#
    ci_order <- order_of_magnitude(ci_range)#
    num_digits <- -ci_order + 1#
#
    ## Format components#
    mu_formatted <- format(round(mu, num_digits), nsmall = max(num_digits, 0))#
    ci05_formatted <- format(floor(ci05 * 10^(num_digits-1)) / 10^(num_digits-1), nsmall = max(0, num_digits-1))#
    ci95_formatted <- format(ceiling(ci95 * 10^(num_digits-1)) / 10^(num_digits-1), nsmall = max(0, num_digits-1))#
#
    ## Concatenate into a single string#
    if (bold == 'mu') {#
        paste0('<b>', mu_formatted, "</b> [", ci05_formatted, " - ", ci95_formatted, "]")#
    } else if (bold == 'ci05') {#
        paste0(mu_formatted, " [<b>", ci05_formatted, "</b> - ", ci95_formatted, "]")#
    } else if (bold == 'ci95') {#
        paste0(mu_formatted, " [", ci05_formatted, " - <b>", ci95_formatted, "</b>]")#
    } else {#
        paste0(mu_formatted, " [", ci05_formatted, " - ", ci95_formatted, "]")#
    }#
}#
#
get.value <- function(df, spdf, scenario, measure, year, quant, regcol.spdf, regcol.df) {#
    print(quant)#
    if (!is.na(regcol.spdf)) {#
        if (quant == 'all') {#
            subdf <- df[df$scenario == scenario & df$measure == measure & df$year == year, ]#
            joinby <- setNames(regcol.df, regcol.spdf)#
            subdf2 <- spdf %>% left_join(subdf, by=joinby)#
            return(subdf2)#
        } else {#
            subdf <- df[df$scenario == scenario & df$measure == measure & df$year == year, c(regcol.df, quant)]#
            joinby <- setNames(regcol.df, regcol.spdf)#
            subdf2 <- spdf %>% left_join(subdf, by=joinby)#
            return(subdf2[, quant, drop=T])#
        }#
    } else {#
        if (quant == 'all') {#
            return(df[df$scenario == scenario & df$measure == measure & df$year == year, ])#
        } else {#
            return(df[df$scenario == scenario & df$measure == measure & df$year == year, quant, drop=T])#
        }#
    }#
}#
#
add.polygons <- function(lt, spdf, scenario, measure, year, quant, regcol.spdf, regcol.df, namecol.spdf, group=NULL) {#
    print("add.polygons")#
    ## Prepare the text for tooltips:#
    allvals <- get.value(df, spdf, scenario, measure, year, 'all', regcol.spdf, regcol.df)#
    alltxts <- sapply(1:nrow(allvals), function(ii) format_estimate_with_ci(allvals$mu[ii], allvals$ci05[ii], allvals$ci95[ii], quant))#
    if (namecol.spdf %in% names(spdf)) {#
        mytext <- paste(#
            "Region: ", spdf[, namecol.spdf, drop=T], "<br/>",#
            "Damages: ", alltxts, "<br/>",#
            sep="") %>%#
            lapply(htmltools::HTML)#
    } else {#
        mytext <- paste(#
            "Region: ", namecol.spdf, "<br/>",#
            "Damages: ", alltxts, "<br/>",#
            sep="") %>%#
            lapply(htmltools::HTML)#
    }#
#
    if (is.null(group))#
        group <- paste(quant, measure, scenario, year, sep="_")#
#
    lt %>% addPolygons(data=spdf,#
                       fillColor = ~mypalette(value),#
                       layerId = ~PID,#
                       stroke=TRUE,#
                       fillOpacity = 0.6,#
                       color="white",#
                       weight=0.3,#
                       label = mytext,#
                       labelOptions = labelOptions(#
                           style = list("font-weight" = "normal", padding = "2px 5px"),#
                           textsize = "11px",#
                           direction = "auto"#
                       ),#
                       group=group)#
}#
#
fix.limits <- function(df) {#
    limits <<- c(quantile(df$ci05, .05), quantile(df$ci95, .95))#
    print(limits)#
    if (all(sign(df$ci05) == sign(df$ci95))) {#
        mypalette <<- colorNumeric(palette="YlOrRd", domain=c(min(limits), max(limits)), na.color="transparent", reverse=F)#
    } else {#
        mypalette <<- colorNumeric(palette="Spectral", domain=c(-max(abs(limits)), max(abs(limits))), na.color="transparent", reverse=T)#
    }#
}#
#
make.map <- function(lt, spdf, channel, scenario, measure, year, quant, regcol.spdf, regcol.df, namecol.spdf, group=NULL) {#
    print("make.map")#
    ## Final Map#
    col <- paste(quant, scenario, year, sep="_")#
    spdf$value <- pmax(limits[1], pmin(limits[2], get.value(df, spdf, scenario, measure, year, quant, regcol.spdf, regcol.df)))#
#
    lt %>%#
        add.polygons(spdf, scenario, measure, year, quant, regcol.spdf, regcol.df, namecol.spdf, group=group)#
}#

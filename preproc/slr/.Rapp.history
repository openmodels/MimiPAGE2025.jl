            rename(scenario=chosen)#
        gsat.likely <- rbind(gsat.likely, newdraws2)#
    }#
    qrange <- qrange + (sum(gsat2100$scenario == 'ssp370') - nrow(gsat.likely) + 4) / nrow(gsat2100)#
}
